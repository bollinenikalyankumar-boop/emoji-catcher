[app]
title = Emoji Catcher
package.name = emojicatcher
package.domain = com.yourname.emojicatcher
source.dir = .
source.include_exts = py,png,jpg,ttf,ogg,wav
version = 1.0.0

requirements = python3,pygame

orientation = portrait
fullscreen = 1
android.archs = arm64-v8a, armeabi-v7a

[buildozer]
log_level = 2
warn_on_root = 1